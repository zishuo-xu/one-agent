{
  "version": 1,
  "model": {
    "connectionId": "default",
    "provider": "openai-compatible",
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "your-api-key",
    "model": "gpt-3.5-turbo",
    "maxTokens": 4096,
    "timeoutMs": 30000
  },
  "modelConnections": [
    {
      "id": "default",
      "name": "Default",
      "provider": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "your-api-key",
      "models": [
        "gpt-3.5-turbo"
      ],
      "maxTokens": 4096
    }
  ],
  "runtime": {
    "systemPrompt": "You are a helpful assistant. Answer concisely and in Chinese by default. When you use the web_search tool, base your answer strictly on the search results returned. If the search returns no useful results, tell the user clearly instead of making up information.",
    "locale": "zh-CN",
    "customInstructions": "默认简洁回答；代码、API 名称和文件路径保持原文。",
    "loop": "auto",
    "maxRetries": 2,
    "maxToolIterations": 5,
    "maxReplanAttempts": 3,
    "maxRetryAttempts": 2,
    "planApproval": true
  },
  "context": {
    "maxTokens": 4096,
    "recentTokenBudget": 2048
  },
  "strategy": {
    "maxInitialToolBatch": 2,
    "maxSwitches": 1
  },
  "budget": {
    "mainAgentTokens": null,
    "subAgentTokens": null
  },
  "subAgent": {
    "enabled": true,
    "maxDepth": 1,
    "maxConcurrency": 4,
    "taskTimeoutMs": 60000,
    "maxToolIterations": 5
  },
  "tools": {
    "disabled": [],
    "requireApproval": [
      "delete_file",
      "run_command"
    ],
    "search": {}
  },
  "trace": {
    "contentMode": "redacted",
    "host": "127.0.0.1",
    "port": 3001,
    "logLevel": "info"
  },
  "storage": {
    "databasePath": "data.db"
  },
  "api": {
    "host": "127.0.0.1",
    "port": 3000,
    "logLevel": "info"
  },
  "taskQueue": {
    "maxConcurrency": 2,
    "taskTimeoutMs": 300000,
    "maxRetries": 3,
    "retryDelayMs": 1000
  },
  "cli": {
    "color": true
  }
}
